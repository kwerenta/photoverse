<div id="<%= dom_id comment %>" class="pt-4">
    <div class="flex items-start gap-2">
      <%= link_to "#{comment.user.username}:", profile_path(comment.user.username), class: "font-semibold opacity-70" %>
      <p class="flex-1"><%= comment.content %></p>
      <div class="flex gap-2 items-center">
      <%= render "likes/button", likeable: comment %>
        <% unless comment.parent_id %>
          <%= button_to "Reply", nil, remote: true,
                data: {
                  controller: "comments",
                  action: "comments#toggleForm",
                  comments_form_param: "comment-reply-form-#{comment.id}"
                },
                class: "btn btn-ghost btn-sm" %>
        <% end %>
        <% if comment.user == current_user %>
          <%= button_to svg_icon("x", class: "w-5 h-5"), [post, comment], method: :delete, class: "btn btn-circle btn-sm btn-ghost" %>
        <% end %>
      </div>
    </div>
    <% unless comment.parent_id %>
      <div id="comment-reply-form-<%= comment.id %>" class="hidden mb-2">
        <%= render "comments/form", post: post, comment: post.comments.build(parent_id: comment.id), submit_text: "Reply" %>
      </div>
    <% end %>
    <% if comment.replies.any? %>
      <div class="pl-6 flex flex-col gap-2">
        <% comment.replies.each do |reply| %>
          <%= render reply, {post: post} %>
        <% end %>
      </div>
    <% end %>
</div>
